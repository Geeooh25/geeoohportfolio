<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Booking System - Flowcharts</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header */
        .header {
            text-align: center;
            padding: 40px 20px;
            background: white;
            border-radius: 20px;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }

        .header h1 {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 10px;
        }

        .header p {
            color: #666;
            font-size: 1.1rem;
        }

        .badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            margin-top: 15px;
        }

        /* Navigation */
        .nav {
            background: white;
            border-radius: 15px;
            padding: 15px 20px;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            position: sticky;
            top: 20px;
            z-index: 100;
        }

        .nav ul {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            list-style: none;
        }

        .nav li a {
            display: block;
            padding: 8px 20px;
            background: #f0f0f0;
            color: #333;
            text-decoration: none;
            border-radius: 25px;
            font-size: 0.9rem;
            transition: all 0.3s;
        }

        .nav li a:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }

        /* Flowchart Card */
        .flowchart-card {
            background: white;
            border-radius: 20px;
            margin-bottom: 40px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px 30px;
            color: white;
        }

        .card-header h2 {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }

        .card-header p {
            opacity: 0.9;
            font-size: 0.9rem;
        }

        .card-body {
            padding: 30px;
            overflow-x: auto;
        }

        /* Flowchart Styles */
        .flowchart {
            font-family: monospace;
            font-size: 13px;
            line-height: 1.8;
            background: #fafafa;
            padding: 30px;
            border-radius: 10px;
            overflow-x: auto;
            white-space: pre;
        }

        /* Legend */
        .legend {
            background: white;
            border-radius: 20px;
            padding: 20px 30px;
            margin-top: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }

        .legend h3 {
            margin-bottom: 15px;
            color: #333;
        }

        .legend-items {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .legend-box {
            width: 30px;
            height: 30px;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .legend-box.start {
            background: #4CAF50;
            color: white;
        }

        .legend-box.process {
            background: #2196F3;
            color: white;
        }

        .legend-box.decision {
            background: #FF9800;
            color: white;
        }

        .legend-box.end {
            background: #f44336;
            color: white;
        }

        .legend-box.database {
            background: #9C27B0;
            color: white;
        }

        .legend-box.external {
            background: #00BCD4;
            color: white;
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 30px;
            color: white;
            margin-top: 20px;
        }

        @media (max-width: 768px) {
            .flowchart {
                font-size: 10px;
                padding: 15px;
            }
            .card-body {
                padding: 15px;
            }
            .nav ul {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
