                        ┌───────────────────────┼───────────────────────┐
                        │                       │                       │
                        ▼                       ▼                       ▼
              ┌─────────────────┐     ┌─────────────────┐     ┌─────────────────┐
              │ Room inactive   │     │ Room in         │     │ Room available  │
              │ or maintenance  │     │ maintenance     │     │ for dates       │
              └────────┬────────┘     └────────┬────────┘     └────────┬────────┘
                       │                       │                       │
                       ▼                       ▼                       │
              ┌─────────────────┐     ┌─────────────────┐               │
              │ Return false    │     │ Return false    │               │
              │ "Room unavailable"│   │ "Under maintenance"│             │
              └─────────────────┘     └─────────────────┘               │
                                                                        │
                                                                        ▼
                                   ┌────────────────────────────────────────┐
                                   │ Query Database for Overlapping        │
                                   │ Bookings                              │
                                   │                                        │
                                   │ SELECT * FROM bookings                │
                                   │ WHERE room_id = :room_id              │
                                   │ AND status NOT IN ('cancelled')       │
                                   │ AND check_in < :check_out             │
                                   │ AND check_out > :check_in             │
                                   └────────────────────┬───────────────────┘
                                                        │
                                                        ▼
                                   ┌────────────────────────────────────────┐
                                   │ Count overlapping bookings            │
                                   └────────────────────┬───────────────────┘
                                                        │
                        ┌───────────────────────────────┼───────────────────────────────┐
                        │                               │                               │
                        ▼                               ▼                               ▼
              ┌─────────────────┐               ┌─────────────────┐               ┌─────────────────┐
              │ Overlaps > 0    │               │ Overlaps = 0    │               │ Overlaps = 0    │
              │ Room is booked  │               │ Room is free    │               │ Room is free    │
              │ for these dates │               │                 │               │                 │
              └────────┬────────┘               └────────┬────────┘               └─────────────────┘
                       │                                 │
                       ▼                                 ▼
              ┌─────────────────┐               ┌────────────────────────────────────────┐
              │ Return false    │               │ Check Guest Capacity                  │
              │ "Room already   │               │                                        │
              │ booked"         │               │ guests_requested ≤ room.capacity      │
              └─────────────────┘               └────────────────────┬───────────────────┘
                                                                    │
                                                 ┌──────────────────┼──────────────────┐
                                                 │                  │                  │
                                                 ▼                  ▼                  ▼
                                       ┌─────────────────┐  ┌─────────────────┐  ┌─────────────────┐
                                       │ Capacity        │  │ Capacity        │  │ Capacity        │
                                       │ Exceeded        │  │ Met             │  │ Under           │
                                       └────────┬────────┘  └────────┬────────┘  └─────────────────┘
                                                │                    │
                                                ▼                    ▼
                                       ┌─────────────────┐  ┌────────────────────────────────────────┐
                                       │ Return false    │  │ Calculate Price                        │
                                       │ "Room cannot    │  │                                        │
                                       │ accommodate X   │  │ • Base price from room type           │
                                       │ guests"         │  │ • Seasonal adjustment                 │
                                       └─────────────────┘  │ • Weekend adjustment                   │
                                                            │ • Long stay discount                   │
                                                            │ • Early bird discount                  │
                                                            └────────────────────┬───────────────────┘
                                                                                 │
